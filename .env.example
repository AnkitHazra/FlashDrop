# Set this to the public HTTPS origin, without a trailing slash.
# Example: https://share.example.com
PUBLIC_BASE_URL=https://your-domain.example

# Use persistent writable storage on your server.
DATA_DIR=./data
UPLOAD_DIR=./data/temp_uploads
DATABASE_PATH=./data/quickshare.sqlite3

# Upload limits
MAX_FILE_SIZE=104857600
# Optional comma-separated allow-list, e.g. pdf,png,jpg,zip,txt
# Leave blank to allow all extensions (size limit still applies).
ALLOWED_EXTENSIONS=

# Cleanup runs every 15 seconds; expiry is always checked at request time.
CLEANUP_INTERVAL_SECONDS=15
LOG_LEVEL=INFO
